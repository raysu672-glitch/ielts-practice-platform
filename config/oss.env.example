# 阿里云 OSS 录播课（复制为 config/oss.env 后填写；oss.env 不提交 GitHub）
#
# AccessKey 使用 RAM 用户「藕叶录播课」那一对，不要用主账号。
# Bucket 必须是私有。

OSS_ACCESS_KEY_ID=你的AccessKeyID
OSS_ACCESS_KEY_SECRET=你的AccessKeySecret
OSS_BUCKET=oyenglish-luboke
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com

# 播放地址有效期（秒），默认 2 小时
OSS_SIGN_EXPIRES=7200
