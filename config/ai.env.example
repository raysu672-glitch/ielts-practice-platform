# 平台统一 AI 配置（当前与后续凡需 AI 介入的功能都走这里）
# 复制为 config/ai.env 后填写真实 Key；ai.env 不提交 GitHub。
#
# 改模型/来源时只改这一处，不要在各模块各自散落配置。

AI_API_KEY=your_deepseek_api_key_here
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash

# 可选调参（作文批改等共用）
AI_THINKING=disabled
AI_MAX_TOKENS=4000
AI_MAX_TOKENS_RETRY=6000
